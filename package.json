{
  "name": "starfall-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "vitest run tests/rules tests/storage",
    "test:simulation": "tsx scripts/validate-collection.ts",
    "test:simulation:free": "tsx scripts/validate-free-skills.ts",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:performance": "tsx scripts/benchmark-simulation.ts",
    "test:assets": "tsx scripts/verify-assets.ts",
    "test:production": "tsx scripts/verify-production.ts",
    "test:simulation:legacy": "tsx scripts/validate-balance.ts",
    "test:tree-matchups": "tsx scripts/probe-free-skills.ts",
    "test:trees:e2e": "playwright test tests/e2e/skill-trees.spec.ts tests/e2e/combat-readability.spec.ts",
    "test:simulation:v2": "tsx scripts/validate-skill-trees.ts",
    "test:tree-matchups:v2": "tsx scripts/probe-skill-trees.ts",
    "test:free:e2e": "playwright test tests/e2e/free-skills.spec.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
